@model DrugPrioritizationAssistant.Application.DTOs.AdminDashboardDto

@{
    ViewData["Title"] = "داشبورد";
}

<!-- =========================================================
     Statistics
     ========================================================= -->

<div class="row g-4">

    
    <!-- Total Drugs -->

    <div class="col-xl-3 col-md-6">

        <div class="dpa-card h-100">

            <div class="dashboard-stat">

                <div class="dashboard-stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-capsule-pill"></i>
                </div>

                <div class="dashboard-stat-title">
                    تعداد داروها
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalDrugs
                </div>

                <div class="small text-muted mt-2">
                    داروهای ثبت‌شده در سامانه
                </div>

            </div>

        </div>

    </div>


    <!-- Need Assessments -->

    <div class="col-xl-3 col-md-6">

        <div class="dpa-card h-100">

            <div class="dashboard-stat">

                <div class="dashboard-stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>

                <div class="dashboard-stat-title">
                    ارزیابی نیاز
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalNeedAssessments
                </div>

                <div class="small text-muted mt-2">
                    @Model.AssessmentCompletionPercentage.ToString("0.#")٪
                    از داروها ارزیابی شده‌اند
                </div>

            </div>

        </div>

    </div>


    <!-- Feasibility -->

    <div class="col-xl-3 col-md-6">

        <div class="dpa-card h-100">

            <div class="dashboard-stat">

                <div class="dashboard-stat-icon bg-info-subtle text-info">
                    <i class="bi bi-flask"></i>
                </div>

                <div class="dashboard-stat-title">
                    امکان تولید
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalFeasibilityAssessments
                </div>

                <div class="small text-muted mt-2">
                    ارزیابی امکان تولید
                </div>

            </div>

        </div>

    </div>


    <!-- Scored -->

    <div class="col-xl-3 col-md-6">

        <div class="dpa-card h-100">

            <div class="dashboard-stat">

                <div class="dashboard-stat-icon bg-success-subtle text-success">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>

                <div class="dashboard-stat-title">
                    داروهای امتیازدهی‌شده
                </div>

                <div class="dashboard-stat-value">
                    @Model.TotalScoredDrugs
                </div>

                <div class="small text-muted mt-2">
                    @Model.TotalPrioritizedDrugs
                    دارو دارای رتبه هستند
                </div>

            </div>

        </div>

    </div>
    

</div>

<!-- =========================================================
     Key Metrics
     ========================================================= -->

<div class="row g-4 mt-1">

    
    <!-- Average Need -->

    <div class="col-xl-4 col-md-6">

        <div class="dpa-card h-100">

            <div class="dpa-card-header">

                <h5 class="mb-0">
                    میانگین شاخص نیاز
                </h5>

            </div>

            <div class="dpa-card-body">

                <div class="display-6 fw-bold">
                    @Model.AverageNeedScore.ToString("0.#")
                </div>

                <div class="progress mt-3" style="height: 8px;">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width:@Model.AverageNeedScore.ToString(
                                                  System.Globalization.CultureInfo.InvariantCulture)%;">
                    </div>

                </div>

                <small class="text-muted d-block mt-2">
                    در مقیاس ۰ تا ۱۰۰
                </small>

            </div>

        </div>

    </div>


    <!-- Average Feasibility -->

    <div class="col-xl-4 col-md-6">

        <div class="dpa-card h-100">

            <div class="dpa-card-header">

                <h5 class="mb-0">
                    میانگین امکان تولید
                </h5>

            </div>

            <div class="dpa-card-body">

                <div class="display-6 fw-bold">
                    @Model.AverageFeasibilityScore.ToString("0.#")
                </div>

                <div class="progress mt-3" style="height: 8px;">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width:@Model.AverageFeasibilityScore.ToString(
                                                  System.Globalization.CultureInfo.InvariantCulture)%;">
                    </div>

                </div>

                <small class="text-muted d-block mt-2">
                    در مقیاس ۰ تا ۱۰۰
                </small>

            </div>

        </div>

    </div>


    <!-- Average Opportunity -->

    <div class="col-xl-4 col-md-6">

        <div class="dpa-card h-100">

            <div class="dpa-card-header">

                <h5 class="mb-0">
                    میانگین امتیاز فرصت
                </h5>

            </div>

            <div class="dpa-card-body">

                <div class="display-6 fw-bold">
                    @Model.AverageOpportunityScore.ToString("0.#")
                </div>

                <div class="progress mt-3" style="height: 8px;">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width:@Model.AverageOpportunityScore.ToString(
                                                  System.Globalization.CultureInfo.InvariantCulture)%;">
                    </div>

                </div>

                <small class="text-muted d-block mt-2">
                    بر اساس وزن‌های فعلی مدل
                </small>

            </div>

        </div>

    </div>
    

</div>

<!-- =========================================================
     Charts
     ========================================================= -->

<div class="row g-4 mt-1">

    
    <!-- Priority Distribution -->

    <div class="col-xl-5">

        <div class="dpa-card h-100">

            <div class="dpa-card-header">

                <h5 class="mb-1">
                    توزیع سطح اولویت
                </h5>

                <small class="text-muted">
                    وضعیت داروهای دارای امتیاز
                </small>

            </div>

            <div class="dpa-card-body">

                <div style="height:320px;">
                    <canvas id="priorityChart"></canvas>
                </div>

            </div>

        </div>

    </div>


    <!-- Need vs Feasibility -->

    <div class="col-xl-7">

        <div class="dpa-card h-100">

            <div class="dpa-card-header">

                <h5 class="mb-1">
                    نیاز در برابر امکان تولید
                </h5>

                <small class="text-muted">
                    موقعیت داروها در فضای تصمیم‌گیری
                </small>

            </div>

            <div class="dpa-card-body">

                <div style="height:320px;">
                    <canvas id="scoreChart"></canvas>
                </div>

            </div>

        </div>

    </div>
    

</div>

<!-- =========================================================
     Top Priority Drugs
     ========================================================= -->

<div class="row g-4 mt-1">

    
    <div class="col-lg-8">

        <div class="dpa-card">

            <div class="dpa-card-header d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-1">
                        داروهای با بالاترین اولویت
                    </h5>

                    <small class="text-muted">
                        پنج داروی برتر بر اساس امتیاز فرصت
                    </small>

                </div>

                <a asp-area="Admin"
                   asp-controller="DrugPriorities"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">

                    مشاهده همه

                    <i class="bi bi-arrow-left ms-1"></i>

                </a>

            </div>


            <div class="dpa-card-body p-0">

                @if (Model.TopPriorityDrugs.Any())
                {
                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead>

                                <tr>

                                    <th class="px-4">
                                        رتبه
                                    </th>

                                    <th>
                                        دارو
                                    </th>

                                    <th>
                                        نیاز
                                    </th>

                                    <th>
                                        امکان تولید
                                    </th>

                                    <th>
                                        امتیاز فرصت
                                    </th>

                                    <th>
                                        اولویت
                                    </th>

                                    <th>
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.TopPriorityDrugs)
                                {
                                    <tr>

                                        <td class="px-4">

                                            <span class="fw-bold">
                                                #@item.Rank
                                            </span>

                                        </td>


                                        <td>

                                            <a asp-area="Admin"
                                               asp-controller="Drugs"
                                               asp-action="Details"
                                               asp-route-id="@item.DrugId"
                                               class="text-decoration-none fw-semibold">

                                                @item.DrugName

                                            </a>

                                            @if (!string.IsNullOrWhiteSpace(item.GenericName))
                                            {
                                                <div class="small text-muted">
                                                    @item.GenericName
                                                </div>
                                            }

                                        </td>


                                        <td>
                                            @item.NeedScore.ToString("0.#")
                                        </td>


                                        <td>
                                            @item.FeasibilityScore.ToString("0.#")
                                        </td>


                                        <td>

                                            <strong>
                                                @item.OpportunityScore.ToString("0.#")
                                            </strong>

                                        </td>


                                        <td>

                                            @if (item.PriorityLevel == "خیلی بالا")
                                            {
                                                <span class="badge bg-danger">
                                                    خیلی بالا
                                                </span>
                                            }
                                            else if (item.PriorityLevel == "بالا")
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    بالا
                                                </span>
                                            }
                                            else if (item.PriorityLevel == "متوسط")
                                            {
                                                <span class="badge bg-info text-dark">
                                                    متوسط
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    پایین
                                                </span>
                                            }

                                        </td>


                                        <td>

                                            <a asp-area="Admin"
                                               asp-controller="DrugPriorities"
                                               asp-action="Details"
                                               asp-route-id="@item.DrugId"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-bar-chart-line"></i>

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">

                        <i class="bi bi-bar-chart-line fs-1 d-block mb-3"></i>

                        هنوز دارویی برای اولویت‌بندی وجود ندارد.

                        <div class="mt-3">

                            <a asp-area="Admin"
                               asp-controller="DrugScores"
                               asp-action="Index"
                               class="btn btn-sm btn-outline-primary">

                                ورود به بخش امتیازدهی

                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Priority Summary -->

    <div class="col-lg-4">

        <div class="dpa-card h-100">

            <div class="dpa-card-header">

                <h5 class="mb-1">
                    خلاصه اولویت‌ها
                </h5>

                <small class="text-muted">
                    بر اساس امتیاز فرصت
                </small>

            </div>

            <div class="dpa-card-body">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <span>
                        <i class="bi bi-circle-fill text-danger me-2"></i>
                        خیلی بالا
                    </span>

                    <strong>
                        @Model.VeryHighPriorityCount
                    </strong>

                </div>


                <div class="d-flex justify-content-between align-items-center mb-4">

                    <span>
                        <i class="bi bi-circle-fill text-warning me-2"></i>
                        بالا
                    </span>

                    <strong>
                        @Model.HighPriorityCount
                    </strong>

                </div>


                <div class="d-flex justify-content-between align-items-center mb-4">

                    <span>
                        <i class="bi bi-circle-fill text-info me-2"></i>
                        متوسط
                    </span>

                    <strong>
                        @Model.MediumPriorityCount
                    </strong>

                </div>


                <div class="d-flex justify-content-between align-items-center">

                    <span>
                        <i class="bi bi-circle-fill text-secondary me-2"></i>
                        پایین
                    </span>

                    <strong>
                        @Model.LowPriorityCount
                    </strong>

                </div>

            </div>

        </div>

    </div>
    

</div>

<!-- =========================================================
     System Status
     ========================================================= -->

<div class="row g-4 mt-1">

    
    <div class="col-12">

        <div class="dpa-card">

            <div class="dpa-card-body">

                <div class="d-flex align-items-center gap-3">

                    <i class="bi bi-check-circle-fill text-success fs-4"></i>

                    <div>

                        <div class="fw-bold">
                            سامانه فعال است
                        </div>

                        <small class="text-muted">
                            سیستم آماده ثبت، ارزیابی و اولویت‌بندی داروهاست.
                        </small>

                    </div>

                    <div class="ms-auto">

                        <span class="badge bg-success-subtle text-success">
                            سیستم عملیاتی
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>
    

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    
    <script>

        // =====================================================
        // Priority Distribution
        // =====================================================

        const priorityChartElement =
            document.getElementById('priorityChart');

        if (priorityChartElement) {

            new Chart(
                priorityChartElement,
                {
                    type: 'doughnut',

                    data: {
                        labels: [
                            'خیلی بالا',
                            'بالا',
                            'متوسط',
                            'پایین'
                        ],

                        datasets: [{
                            data: [
                                @Model.VeryHighPriorityCount,
                                @Model.HighPriorityCount,
                                @Model.MediumPriorityCount,
                                @Model.LowPriorityCount
                            ]
                        }]
                    },

                    options: {
                        responsive: true,
                        maintainAspectRatio: false,

                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        },

                        cutout: '65%'
                    }
                }
            );
        }


        // =====================================================
        // Need vs Feasibility
        // =====================================================

        const scoreChartElement =
            document.getElementById('scoreChart');

        if (scoreChartElement) {

            new Chart(
                scoreChartElement,
                {
                    type: 'scatter',

                    data: {

                        datasets: [{
                            label: 'داروها',

                            data: [

                                @foreach (var item in Model.ScorePoints)
                                {
                                        <text>
                                        {
                                            x: @item.NeedScore.ToString(
                                                                                        System.Globalization.CultureInfo.InvariantCulture),
                                    y: @item.FeasibilityScore.ToString(
                                                                                System.Globalization.CultureInfo.InvariantCulture)
                                },
                                </text>
                                                        }

                            ]

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        scales: {

                            x: {

                                min: 0,
                                max: 100,

                                title: {
                                    display: true,
                                    text: 'شاخص نیاز'
                                }

                            },

                            y: {

                                min: 0,
                                max: 100,

                                title: {
                                    display: true,
                                    text: 'امکان تولید'
                                }

                            }

                        },

                        plugins: {

                            legend: {
                                display: false
                            }

                        }

                    }

                }
            );

        }

    </script>
}
