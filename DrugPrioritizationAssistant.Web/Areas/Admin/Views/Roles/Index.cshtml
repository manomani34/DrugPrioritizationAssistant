@using DrugPrioritizationAssistant.Infrastructure.Identity
@using DrugPrioritizationAssistant.Infrastructure.Services
@using Microsoft.AspNetCore.Identity

@model List<DrugPrioritizationAssistant.Web.Areas.Admin.Controllers.RoleListItemViewModel>

@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "مدیریت نقش‌ها";

    var currentUser =
        await UserManager.GetUserAsync(User);

    var canView =
        currentUser != null &&
        await PermissionService.HasPermissionAsync(
            currentUser.Id,
            "Roles.View");

    var canCreate =
        currentUser != null &&
        await PermissionService.HasPermissionAsync(
            currentUser.Id,
            "Roles.Create");

    var canDelete =
        currentUser != null &&
        await PermissionService.HasPermissionAsync(
            currentUser.Id,
            "Roles.Delete");
}


@if (canView)
{
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h4 class="fw-bold mb-1">
                    مدیریت نقش‌ها
                </h4>

                <div class="text-muted">
                    مدیریت نقش‌های کاربران سامانه
                </div>

            </div>


            @if (canCreate)
            {
                <a asp-area="Admin"
                   asp-controller="Roles"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>

                    نقش جدید

                </a>
            }

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">

                <i class="bi bi-check-circle me-1"></i>

                @TempData["Success"]

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">

                <i class="bi bi-exclamation-triangle me-1"></i>

                @TempData["Error"]

            </div>
        }


        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    نام نقش
                                </th>

                                <th>
                                    تعداد کاربران
                                </th>

                                <th>
                                    وضعیت
                                </th>

                                @if (canDelete)
                                {
                                    <th class="text-center">
                                        عملیات
                                    </th>
                                }

                            </tr>

                        </thead>


                        <tbody>

                            @if (Model.Count == 0)
                            {
                                <tr>

                                    <td colspan="@(canDelete ? 5 : 4)"
                                        class="text-center text-muted py-5">

                                        هیچ نقشی ثبت نشده است.

                                    </td>

                                </tr>
                            }
                            else
                            {
                                var index = 1;

                                foreach (var role in Model)
                                {
                                    <tr>

                                        <td>
                                            @index
                                        </td>


                                        <td>

                                            <span class="fw-semibold">
                                                @role.Name
                                            </span>

                                        </td>


                                        <td>

                                            <span class="badge bg-secondary">
                                                @role.UserCount
                                            </span>

                                        </td>


                                        <td>

                                            @if (role.IsSystemRole)
                                            {
                                                <span class="badge bg-primary">
                                                    نقش سیستمی
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    سفارشی
                                                </span>
                                            }

                                        </td>


                                        @if (canDelete)
                                        {
                                            <td class="text-center">

                                                @if (role.IsSystemRole)
                                                {
                                                    <span class="text-muted small">
                                                        قابل حذف نیست
                                                    </span>
                                                }
                                                else if (role.UserCount > 0)
                                                {
                                                    <span class="text-muted small">
                                                        دارای کاربر
                                                    </span>
                                                }
                                                else
                                                {
                                                    <form asp-area="Admin"
                                                          asp-controller="Roles"
                                                          asp-action="Delete"
                                                          method="post"
                                                          class="d-inline"
                                                          onsubmit="return confirm('آیا از حذف این نقش مطمئن هستید؟');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@role.Id" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger">

                                                            <i class="bi bi-trash me-1"></i>

                                                            حذف

                                                        </button>

                                                    </form>
                                                }

                                            </td>
                                        }

                                    </tr>

                                    index++;
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
}