@using DrugPrioritizationAssistant.Infrastructure.Identity
@using DrugPrioritizationAssistant.Infrastructure.Services
@using Microsoft.AspNetCore.Identity

@model List<PermissionItemDto>

@inject UserManager<ApplicationUser> UserManager
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "مدیریت دسترسی‌ها";

    var roles =
        ViewBag.Roles
        as IEnumerable<IdentityRole<int>>
        ?? [];

    int? selectedRoleId =
        ViewBag.SelectedRoleId;

    string selectedRoleName =
        ViewBag.SelectedRoleName
        ?? string.Empty;


    var currentUser =
        await UserManager.GetUserAsync(User);

    var canView =
        currentUser != null &&
        await PermissionService.HasPermissionAsync(
            currentUser.Id,
            "Permissions.View");

    var canAssign =
        currentUser != null &&
        await PermissionService.HasPermissionAsync(
            currentUser.Id,
            "Permissions.Assign");
}


@if (canView)
{
    <div class="container-fluid">

        <div class="mb-4">

            <h4 class="fw-bold mb-1">
                مدیریت دسترسی‌ها
            </h4>

            <div class="text-muted">
                دسترسی‌های قابل استفاده برای هر نقش را مدیریت کنید.
            </div>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">

                <i class="bi bi-check-circle me-1"></i>

                @TempData["Success"]

            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">

                <i class="bi bi-exclamation-triangle me-1"></i>

                @TempData["Error"]

            </div>
        }


        <!-- Role Selection -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-body">

                <form asp-area="Admin"
                      asp-controller="Permissions"
                      asp-action="Index"
                      method="get">

                    <div class="row align-items-end">

                        <div class="col-md-6">

                            <label class="form-label">
                                نقش
                            </label>

                            <select name="roleId"
                                    class="form-select">

                                <option value="">
                                    انتخاب نقش
                                </option>

                                @foreach (var role in roles)
                                {
                                    if (selectedRoleId == role.Id)
                                    {
                                        <option value="@role.Id"
                                                selected>
                                            @role.Name
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@role.Id">
                                            @role.Name
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <div class="col-md-3">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>

                                نمایش دسترسی‌ها

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>


        @if (selectedRoleId.HasValue)
        {
            <form asp-area="Admin"
                  asp-controller="Permissions"
                  asp-action="Save"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="roleId"
                       value="@selectedRoleId" />


                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <span class="fw-bold">
                                    دسترسی‌های نقش:
                                </span>

                                <span class="badge bg-primary ms-2">
                                    @selectedRoleName
                                </span>

                            </div>


                            @if (canAssign)
                            {
                                <button type="submit"
                                        class="btn btn-success">

                                    <i class="bi bi-check-lg me-1"></i>

                                    ذخیره دسترسی‌ها

                                </button>
                            }

                        </div>

                    </div>


                    <div class="card-body">

                        @{
                            var groups =
                                Model
                                    .GroupBy(x => x.GroupName)
                                    .OrderBy(x => x.Key);
                        }


                        @foreach (var group in groups)
                        {
                            <div class="mb-4">

                                <h6 class="fw-bold border-bottom pb-2 mb-3">

                                    <i class="bi bi-folder2-open me-1"></i>

                                    @group.Key

                                </h6>


                                <div class="row">

                                    @foreach (var permission in group)
                                    {
                                        <div class="col-lg-4 col-md-6 mb-3">

                                            <div class="form-check">

                                                @if (canAssign)
                                                {
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           name="permissionIds"
                                                           value="@permission.Id"
                                                           id="permission_@permission.Id"
                                                           @(permission.IsAssigned ? "checked" : "") />
                                                }
                                                else
                                                {
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           id="permission_@permission.Id"
                                                           checked="@permission.IsAssigned"
                                                           disabled />
                                                }


                                                <label class="form-check-label"
                                                       for="permission_@permission.Id">

                                                    <span class="fw-semibold">
                                                        @permission.DisplayName
                                                    </span>

                                                    <small class="d-block text-muted">
                                                        @permission.Name
                                                    </small>

                                                </label>

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>
                        }


                        @if (!canAssign)
                        {
                            <div class="alert alert-light border mt-3 mb-0">

                                <i class="bi bi-lock me-2"></i>

                                شما فقط مجوز مشاهده دسترسی‌ها را دارید
                                و امکان تغییر آن‌ها برای شما فعال نیست.

                            </div>
                        }

                    </div>

                </div>

            </form>
        }
        else
        {
            <div class="card shadow-sm border-0">

                <div class="card-body text-center py-5">

                    <i class="bi bi-shield-lock display-4 text-muted"></i>

                    <h5 class="mt-3">
                        یک نقش انتخاب کنید
                    </h5>

                    <p class="text-muted mb-0">
                        برای مشاهده و مدیریت دسترسی‌ها،
                        ابتدا یک نقش را انتخاب کنید.
                    </p>

                </div>

            </div>
        }

    </div>
}